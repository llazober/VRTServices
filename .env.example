# ── CRM Master Environment Variables Template ──────────────────────────────
# Copy this file to .env locally or set these in your Easypanel / Hosting Panel

# App Authentication Credentials
APP_USERNAME=admin@vrtservices12.com
APP_PASSWORD=your_secure_app_password_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_db_password_here@161.35.119.223:5432/VRT?sslmode=disable
POSTGRES_DB=VRT

# DigitalOcean Spaces Storage Credentials
DO_SPACES_KEY=your_do_spaces_access_key_here
DO_SPACES_SECRET=your_do_spaces_secret_key_here
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=datalazocrm
DO_SPACES_REGION=nyc3

# QuickBooks Online Integration (Optional)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://datalazo.net/auth/qbo/callback
QBO_ENVIRONMENT=sandbox

# Resend Email Service (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notification@datalazo.net
RESEND_TO_EMAIL=luislazo@datalazo.net

# AI Engine Credentials (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
